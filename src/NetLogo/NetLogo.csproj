<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>        
        <Version>1.0.0</Version>        
        <RootNamespace>netlogo</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.9"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.9" PrivateAssets="all"/>
        <PackageReference Include="SharpCoreFileSystem" Version="1.1.2"/>
        <PackageReference Include="sly" Version="3.7.6"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\net.logo.interpreter\net.logo.interpreter.csproj" />
      <ProjectReference Include="..\net.logo.model\net.logo.model.csproj" />
      <ProjectReference Include="..\net.logo.parser\net.logo.parser.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="samples\trees.logo" />
      <None Remove="samples\polygone.logo" />
      <EmbeddedResource Include="samples\polygones.logo" />
    </ItemGroup>

    <Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
        <Exec Command="git rev-parse HEAD" ConsoleToMsBuild="true" IgnoreExitCode="False">
            <Output PropertyName="SourceRevisionId" TaskParameter="ConsoleOutput" />
        </Exec>
    </Target>
    
</Project>
