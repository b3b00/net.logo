@page "/Edit"
@using NetLogo.services
@inject ILogoContext logoContext;
@inject NavigationManager navigationManager

<div>
    
    <div>
        
        <h1>@logoContext.SampleName</h1>
        <h3>@logoContext.SampleDescription</h3>

        <div style="display: block">
            <label for="preset">grammars : </label>
            <select class="form-control d-flex" @onchange="SelectSample" id="preset">
                @foreach (var template in logoContext.GetSamples())
                {
                    <option value=@template.name>@(!string.IsNullOrEmpty(template.name) ? $"{template.name} - {template.description}" : "")</option>
                }
            </select>
        </div>


        
        

        <div id="graph">
            <div id="output">
                <div id="error">
                    @foreach (var message in messages)
                    {
                    <p style="color:black; background-color: lawngreen ">@message</p>
                    }

                    @foreach (var error in errors)
                    {
                    <p style="color:black; background-color: darksalmon ">@error</p>
                    }

                </div>
            </div>
        </div>


       

        <div class="input" style="display: flex;flex-direction: column">
            <div style="flex-direction: row; display: flex">
                <textarea cols="4" @bind="Lines"></textarea>
                <textarea style="overflow: hidden; width: 100%; height: 1301px;" i d="inputBox" maxlength="2000" spellcheck="false" @bind="Source"  />
            </div>

        </div>

       

    </div>


   
</div>

@code {
    

    [Parameter] public string? Title { get; set; }

    private string Source
    {
        get => logoContext.Source ?? "";
        set
        {
            logoContext.Source = value;
            CleanOutput();
        }
    }
    
    private string Lines { get; set; }
    
    protected override async void OnInitialized()
    {
    }
    
    

    




   


    


    private List<string> messages = new List<string>();
    private List<string> errors = new List<string>();
    
    

    public async void SelectSample(ChangeEventArgs e)
    {
        errors.Clear();
        messages.Clear();
        string sampleName = e.Value?.ToString() ?? "";
        logoContext.SetSample(sampleName);
        StateHasChanged();
    }

    private void CleanOutput()
    {
        errors.Clear();
        messages.Clear();
        StateHasChanged();
    }


    
}
