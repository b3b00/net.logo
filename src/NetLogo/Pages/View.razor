@page "/View"
@using NetLogo
@using NetLogo.services
@inject ILogoContext logoContext;
@inject ILogoCompiler logoCompiler;
@inject NavigationManager navigationManager

<div>
    
    <div>
        
        <h1>@logoContext.SampleName</h1>
        <h3>@logoContext.SampleDescription</h3>

        
            @((MarkupString)logoContext.Draw)
        

       

    </div>


   
</div>

@code {
    
    protected override async void OnInitialized()
    {
        var result = logoCompiler.Compile(logoContext.Source);
        if (result.Success)
        {
            logoContext.Draw = result.Draw;
        }
        else
        {
            foreach (var error in result.Errors)
            {
                 Console.WriteLine(error);   
            }
        }
    }

    
}
