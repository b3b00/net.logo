
PO POLYGONE :SIDES :LENGTH
  REPEAT :SIDES
  [
    FORWARD :LENGTH
    TR 360/:SIDES
  ]
END

PO TREE :size
   IF (:size < 5) 
    [
        FO :size 
        BACK :size 
    ]
    ELSE 
    [
       FO :size/3
       TL 30 
       TREE :size * 2 / 3 
       TR 30
       FO :size/6
       TR 25 
       TREE :size/2 
       TL 25
       FO :size/3
       TR 25 
       TREE :size/2 
       TL 25
       FO :size/6
       BACK :size
   ]
END



PO CIRCLE :STEP
  REPEAT 360
  [
    FORWARD :STEP
    TR 1
  ]
END





PO STAR :LENGTH
  REPEAT 5 [ FO :LENGTH TR 144 ]
END

PO ARROW
  FO 100
  TR 3*45
  FO 25
  BA 25
  TL 6*45
  FO 25
END 

PO OCTOGONE :LENGTH
  REPEAT 8
  [
    FORWARD :LENGTH
    TR 45
  ]
END

PD



